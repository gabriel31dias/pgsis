PORT=8000
JWT_SECRET=troque-este-segredo
DB_PATH=data.sqlite
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
# Gatebox (Pix out). Sem client id/secret o worker não roda e os aprovados ficam na fila.
GATEBOX_URL=https://api.gatebox.com.br
GATEBOX_CLIENT_ID=
GATEBOX_CLIENT_SECRET=
# opcional: só se o IP do servidor não estiver na allowlist da Gatebox
GATEBOX_SIGNING_SECRET=
PAYOUT_INTERVAL_MS=10000
